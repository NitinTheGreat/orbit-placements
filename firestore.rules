rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isVitStudent() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@vitstudent[.]ac[.]in');
    }

    function isAdmin() {
      return isVitStudent() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isVitStudent() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /gmailTokens/{uid} {
      allow read, write: if false;
    }

    match /processedMessages/{messageId} {
      allow read, write: if false;
    }

    match /config/{document} {
      allow read: if isVitStudent();
      allow write: if false;
    }

    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.vitEmail.lower() == request.auth.token.email.lower()
        && !request.resource.data.keys().hasAny(['gmailSync']);
      allow update: if isOwner(uid)
        && request.resource.data.vitEmail == resource.data.vitEmail
        && !changedKeys().hasAny(['gmailSync']);
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isVitStudent();
      allow write: if isAdmin();
    }

    match /studentCompanyStatus/{statusId} {
      allow read: if isVitStudent()
        && (resource.data.studentId == request.auth.uid || isAdmin());

      allow create: if isVitStudent()
        && request.resource.data.studentId == request.auth.uid
        && statusId == request.auth.uid + '_' + request.resource.data.companyId
        && request.resource.data.keys().hasOnly(
             ['studentId', 'companyId', 'optedIn', 'updatedAt', 'source'])
        && request.resource.data.optedIn is bool;

      allow update: if isVitStudent()
        && resource.data.studentId == request.auth.uid
        && changedKeys().hasOnly(['optedIn', 'updatedAt'])
        && request.resource.data.optedIn is bool;

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
