<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orbit_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/orbit_widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/splash_logo"
            android:contentDescription="@string/orbit_widget_name" />

        <TextView
            android:id="@+id/orbit_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#F0D19A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/orbit_widget_name" />
    </LinearLayout>

    <TextView
        android:id="@+id/orbit_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#A39B8E"
        android:textSize="13sp"
        android:visibility="gone"
        android:text="@string/orbit_widget_empty" />

    <LinearLayout
        android:id="@+id/orbit_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/orbit_name_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F5F3EF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/orbit_line_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A39B8E"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/orbit_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/orbit_name_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F5F3EF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/orbit_line_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A39B8E"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
